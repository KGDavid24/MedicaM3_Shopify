{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif
-%}
{% capture accordion_children %}
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-custom-popover{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        on:change="/updatePriceFilterAndResults"
      >
        <script src="{{ 'dalbe-price-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>

        {%- comment -%}
          dalbe: these are raw MINOR UNITS (bani/cents), NOT display values --
          filter.range_max / min_value.value / max_value.value are already in
          minor units, and they're passed through untouched so the slider's
          own arithmetic matches how the native price-facet-component
          represents money internally (see assets/dalbe-price-slider.js,
          which converts to/from display text via the theme's own
          money-formatting helpers).

          Deliberately NOT money_without_currency here: that applies locale
          thousands/decimal separators (e.g. "17.200,00" for this shop's RO
          locale), which HTML treats as an invalid min/max/value on a range
          input and silently falls back to its own default 0-100 range.

          Nil-checked rather than using `| default:` -- Liquid's `default`
          only substitutes for nil/false/empty, never for 0, and a filter
          legitimately set to 0 must stay distinguishable from "no filter".
        {%- endcomment -%}
        {%- assign slider_max = filter.range_max -%}
        {%- assign slider_min_value = 0 -%}
        {%- if filter.min_value.value -%}
          {%- assign slider_min_value = filter.min_value.value -%}
        {%- endif -%}
        {%- assign slider_max_value = slider_max -%}
        {%- if filter.max_value.value -%}
          {%- assign slider_max_value = filter.max_value.value -%}
        {%- endif -%}
        <dalbe-price-slider class="dalbe-price-slider">
          <div class="dalbe-price-slider__track">
            <div
              class="dalbe-price-slider__fill"
              data-slider-fill
            ></div>
          </div>
          <div
            class="dalbe-price-slider__handle"
            data-slider-handle-min
            aria-hidden="true"
          ></div>
          <div
            class="dalbe-price-slider__handle"
            data-slider-handle-max
            aria-hidden="true"
          ></div>
          <input
            type="range"
            class="dalbe-price-slider__input dalbe-price-slider__input--min"
            min="0"
            max="{{ slider_max }}"
            step="100"
            value="{{ slider_min_value }}"
            data-slider-min
            aria-label="{{ 'accessibility.price_filter_low' | t }}"
          >
          <input
            type="range"
            class="dalbe-price-slider__input dalbe-price-slider__input--max"
            min="0"
            max="{{ slider_max }}"
            step="100"
            value="{{ slider_max_value }}"
            data-slider-max
            aria-label="{{ 'accessibility.price_filter_high' | t }}"
          >
        </dalbe-price-slider>

        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- assign formatted_highest_price = filter.range_max | money -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_children,
  class: 'facets__item',
  open: is_vertical,
  open_by_default_on_desktop: is_vertical,
  open_by_default_on_mobile: is_vertical,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal
%}

{% stylesheet %}
  /* dalbe: two-handle drag slider, kept in sync with the native min/max
     text inputs below it rather than replacing their filtering logic --
     see assets/dalbe-price-slider.js.

     The track and the two round handles you actually SEE are plain
     positioned <div>s (.dalbe-price-slider__track/__fill/__handle),
     positioned by JS as percentages -- not native ::-webkit-slider-thumb
     pseudo-elements. Two real <input type="range"> still exist and still
     drive dragging/keyboard/accessibility, but are fully invisible
     (opacity: 0) with their own native thumb hit-area left exactly where
     it always was, just painting nothing.

     This replaced an earlier version that styled the native thumbs
     directly (background/border on ::-webkit-slider-thumb). That's a much
     more common technique, but proved unreliable to even VERIFY here --
     both of this theme's two filter surfaces (the mobile full-screen
     dialog and the desktop floating-panel dropdown) open via a CSS
     opacity/transform transition, and repeatedly inspecting them
     mid-transition produced misleading results. Rather than keep
     debugging a component whose actual rendered state was hard to pin
     down, moving the VISIBLE part to plain divs I fully control removes
     the dependency on native thumb rendering/appearance-reset behavior
     entirely -- the same category of thing that was making this hard to
     verify in the first place. */
  .dalbe-price-slider {
    position: relative;
    height: 32px;
    /* dalbe: reserves room for half the handle's own diameter (20px) on
       each side, so a handle at the very min/max of the range doesn't
       have its edge flush against (or clipped by) the container edge. */
    margin-inline: 10px;
    margin-block: 4px 12px;
  }

  .dalbe-price-slider__track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    transform: translateY(-50%);
    background: #e5e7eb;
    border-radius: 999px;
  }

  .dalbe-price-slider__fill {
    position: absolute;
    top: 50%;
    height: 4px;
    transform: translateY(-50%);
    background: var(--dalbe-navy, #131f5d);
    border-radius: 999px;
  }

  .dalbe-price-slider__handle {
    position: absolute;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--dalbe-navy, #131f5d);
    border: 3px solid #ffffff;
    box-shadow: 0 1px 4px rgba(19, 31, 93, 0.45);
    pointer-events: none;
  }

  .dalbe-price-slider__input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 32px;
    margin: 0;
    background: transparent;
    opacity: 0;
    -webkit-appearance: none;
    appearance: none;
    pointer-events: none;
  }

  .dalbe-price-slider__input::-webkit-slider-runnable-track {
    -webkit-appearance: none;
    background: transparent;
    height: 32px;
  }

  .dalbe-price-slider__input::-moz-range-track {
    background: transparent;
    height: 32px;
    border: none;
  }

  .dalbe-price-slider__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: auto;
    width: 20px;
    height: 20px;
    margin-top: 6px;
    border-radius: 50%;
    cursor: pointer;
  }

  .dalbe-price-slider__input::-moz-range-thumb {
    pointer-events: auto;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
  }

  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: right;
    padding-left: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    color: var(--color-foreground-muted);
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }
{% endstylesheet %}
