{%- doc -%}
  Cart-total-driven "you're X away from free shipping" bar. Threshold is a
  display-only constant (500 RON) -- it is NOT read from the store's real
  configured shipping rate, so if that rate ever changes this needs a
  matching one-line update here (see `assign threshold` below).

  Rendered inside the main content column of both cart surfaces, directly
  below the "Cart" title and above the line-item list -- as a plain
  auto-placed child of .cart-page's grid (sections/main-cart.liquid, both
  the live render and the empty-cart template), a sibling of
  .cart-page__title and .cart-page__items. Deliberately NOT given a
  grid-column override: .cart-page__summary spans grid-row: 1 / -1 in its
  own column, and an earlier attempt at spanning this bar across both
  columns (grid-column: 1 / -1) broke that row math and visibly displaced
  the summary card. Staying a normal column-1 child avoids that entirely.
  In the drawer (snippets/cart-drawer.liquid) it sits below the drawer's
  own header, above the scrollable item list.

  Both surfaces already re-render this on every add/remove/quantity-change
  as part of the cart's normal Section Rendering morph, so this updates for
  free with no widget-specific JS.
{%- enddoc -%}

{% liquid
  assign threshold = 50000
  assign current = cart.total_price
  assign remaining = threshold | minus: current
  if remaining < 0
    assign remaining = 0
  endif
  assign percent = current | times: 100.0 | divided_by: threshold | round
  if percent > 100
    assign percent = 100
  endif
  assign qualified = false
  if remaining <= 0
    assign qualified = true
  endif
  assign remaining_money = remaining | money
  assign threshold_money = threshold | money
%}

{% unless cart.empty? %}
  <div
    class="dalbe-free-shipping-bar"
    {% if qualified %}
      data-qualified
    {% endif %}
  >
    <div class="dalbe-free-shipping-bar__row">
      <span
        class="dalbe-free-shipping-bar__icon"
        aria-hidden="true"
      >
        {% if qualified %}
          <span class="svg-wrapper">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
        {% else %}
          <svg
            class="dalbe-free-shipping-bar__truck-icon"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path d="M0 3.75156C0 3.47454 0.224196 3.24997 0.500755 3.24997H10.647C10.9235 3.24997 11.1477 3.47454 11.1477 3.75156V5.07505V5.63362V6.10938V13.6616C10.9427 14.0067 10.8813 14.1101 10.5516 14.6648L7.22339 14.6646V13.6614H10.1462V4.25316H1.00151V13.6614H2.6842V14.6646H0.500755C0.224196 14.6646 0 14.44 0 14.163V3.75156Z" />
            <path d="M18.9985 8.08376L11.1477 6.10938V5.07505L19.6212 7.20603C19.8439 7.26203 20 7.46255 20 7.69253V14.1631C20 14.4401 19.7758 14.6647 19.4992 14.6647H17.3071V13.6615H18.9985V8.08376ZM11.1477 13.6616L13.3442 13.6615L13.3443 14.6647L10.5516 14.6648L11.1477 13.6616Z" />
            <path d="M7.71269 14.1854C7.71269 15.6018 6.56643 16.75 5.15245 16.75C3.73847 16.75 2.59221 15.6018 2.59221 14.1854C2.59221 12.7691 3.73847 11.6209 5.15245 11.6209C6.56643 11.6209 7.71269 12.7691 7.71269 14.1854ZM5.15245 15.7468C6.01331 15.7468 6.71118 15.0478 6.71118 14.1854C6.71118 13.3231 6.01331 12.6241 5.15245 12.6241C4.29159 12.6241 3.59372 13.3231 3.59372 14.1854C3.59372 15.0478 4.29159 15.7468 5.15245 15.7468Z" />
            <path d="M17.5196 14.1854C17.5196 15.6018 16.3733 16.75 14.9593 16.75C13.5454 16.75 12.3991 15.6018 12.3991 14.1854C12.3991 12.7691 13.5454 11.6209 14.9593 11.6209C16.3733 11.6209 17.5196 12.7691 17.5196 14.1854ZM14.9593 15.7468C15.8202 15.7468 16.5181 15.0478 16.5181 14.1854C16.5181 13.3231 15.8202 12.6241 14.9593 12.6241C14.0985 12.6241 13.4006 13.3231 13.4006 14.1854C13.4006 15.0478 14.0985 15.7468 14.9593 15.7468Z" />
          </svg>
        {% endif %}
      </span>
      <p class="dalbe-free-shipping-bar__message">
        {% if qualified %}
          {{ 'content.free_shipping_qualified' | t }}
        {% else %}
          {{ 'content.free_shipping_remaining_html' | t: amount: remaining_money, threshold: threshold_money }}
        {% endif %}
      </p>
    </div>
    <div
      class="dalbe-free-shipping-bar__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ percent }}"
    >
      <div
        class="dalbe-free-shipping-bar__fill"
        style="width: {{ percent }}%;"
      ></div>
      <span class="dalbe-free-shipping-bar__marker"></span>
    </div>
  </div>
{% endunless %}

{% stylesheet %}
  /* dalbe: light navy-tinted card (same background family as the trust
     badges / product-card image backdrop elsewhere on the site) rather
     than a solid block -- this sits inline in the cart's normal reading
     flow, right under the "Cart" title, so it should read as a helpful
     aside, not a loud interruption. */
  .dalbe-free-shipping-bar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f4f5fb;
    border-radius: 10px;
    padding: 14px 16px;
    margin-block: var(--margin-lg, 16px);
  }

  .dalbe-free-shipping-bar__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dalbe-free-shipping-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--dalbe-navy, #131f5d);
  }

  .dalbe-free-shipping-bar__truck-icon,
  .dalbe-free-shipping-bar__icon .svg-wrapper svg {
    width: 18px;
    height: 18px;
  }

  .dalbe-free-shipping-bar__message {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: #2d3748;
  }

  .dalbe-free-shipping-bar__message strong {
    color: var(--dalbe-red, #e9324e);
    font-weight: 700;
  }

  .dalbe-free-shipping-bar[data-qualified] .dalbe-free-shipping-bar__message {
    font-weight: 700;
    color: var(--dalbe-navy, #131f5d);
  }

  .dalbe-free-shipping-bar__track {
    position: relative;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: #dfe2f3;
    overflow: visible;
  }

  .dalbe-free-shipping-bar__fill {
    position: relative;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #131f5d, #3b4d9e);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dalbe-free-shipping-bar__fill::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        110deg,
        transparent 20%,
        rgba(255, 255, 255, 0.45) 45%,
        transparent 70%
      );
      background-size: 200% 100%;
      animation: dalbe-free-shipping-sheen 2.6s ease-in-out infinite;
    }
  }

  @keyframes dalbe-free-shipping-sheen {
    0% {
      background-position: 150% 0;
    }
    100% {
      background-position: -50% 0;
    }
  }

  /* dalbe: small fixed milestone marker at the halfway point of the track
     -- a cheap decorative detail that reads as "considered design", not a
     literal indicator of a second threshold. */
  .dalbe-free-shipping-bar__marker {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    background: #ffffff;
    border: 1px solid #c3c9e8;
    transform: translate(-50%, -50%) rotate(45deg);
    border-radius: 1px;
  }

  .dalbe-free-shipping-bar[data-qualified] .dalbe-free-shipping-bar__marker {
    border-color: var(--dalbe-navy, #131f5d);
  }
{% endstylesheet %}
