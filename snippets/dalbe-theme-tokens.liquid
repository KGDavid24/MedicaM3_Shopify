{%- doc -%}
  Single source of truth for this project's brand color tokens, rendered once
  globally from layout/theme.liquid. Individual dalbe-* sections should
  reference these vars rather than declaring/hardcoding their own copies.

  Colors match medicam3.ro (the actual client site) directly, confirmed via
  computed styles on the live site: navy for nav/links/prices/general CTAs,
  red reserved specifically for "Adaugă în coș" and sale/discount prices.
  Earlier work in this project used a teal (#00babc) pulled from dentstore.ro
  (an unrelated reference site used earlier in the project) — that never
  matched this client's actual brand and has been replaced.
{%- enddoc -%}

{% style %}
  :root {
    --dalbe-navy: #131f5d;
    --dalbe-red: #e9324e;
    --dalbe-text: #222222;
    --dalbe-heading: #020202;
    --dalbe-header-text: #222222;
  }

  /* dalbe: Horizon's own full-width section CSS (assets/base.css,
     --full-page-margin-inline-offset) uses raw 100vw, which on any
     browser that reserves space for a persistent scrollbar (most desktop
     Windows browsers) is wider than the actual visible viewport —
     causing horizontal scroll on any page with a full-width section.
     html/body alone doesn't fix this: at >=990px Horizon freezes
     html/body (base.css's `html:has(.page-wrapper) { overflow: hidden }`)
     and makes .page-wrapper itself the real scrolling element
     (overflow-y: auto, no overflow-x set, so it defaults to visible) —
     .page-wrapper is the element that actually needs clipping. Setting
     it on both here covers desktop (.page-wrapper) and mobile
     (html/body, since .page-wrapper isn't independently scrollable
     below 990px). */
  html, body {
    overflow-x: hidden;
  }

  .page-wrapper {
    overflow-x: hidden;
  }

  /* dalbe: brand styling for the stock Horizon blog listing
     (sections/main-blog.liquid + blocks/_blog-post-card.liquid) — that
     component already renders image/title/date/excerpt/read-more
     automatically per article, just unstyled. Overridden globally here
     rather than forking the section, since the stock block structure
     already does everything the Articole page needs. */
  .blog-post-item {
    border: none !important;
    padding: 0 !important;
    height: 100%;
  }

  /* Equal-height cards: .shopify-block (Shopify's own theme-editor drag/
     drop wrapper around every block) is the actual grid item that
     stretches to the row height — our styled .blog-post-card sits one
     level deeper and needs height:100% explicitly to follow suit,
     otherwise each card just sizes to its own excerpt length. */
  .blog-posts-container {
    align-items: stretch;
  }

  .blog-post-item .shopify-block {
    height: 100%;
  }

  .blog-post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 20px;
    padding: 20px;
    box-sizing: border-box;
    box-shadow: 0 2px 8px rgba(19, 31, 93, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .blog-post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px -8px rgba(19, 31, 93, 0.2);
  }

  .blog-post-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-post-card__title-link,
  .blog-post-card__title-link .text-block {
    color: var(--dalbe-navy) !important;
    font-weight: 800;
    font-size: 1.375rem !important;
    line-height: 1.3 !important;
    letter-spacing: -0.01em;
  }

  .blog-post-card__title-link:hover {
    opacity: 0.8;
  }

  .blog-post-card .blog-post-details {
    font-size: 0.9375rem !important;
    font-weight: 600;
    color: var(--dalbe-navy);
    opacity: 0.6;
  }

  .blog-post-card__content-text {
    color: var(--dalbe-text, #222222);
    font-size: 1.0625rem !important;
    line-height: 1.6;
    flex: 1;
  }

  .blog-post-card__content-text a {
    display: block;
    margin-block-start: 0.5em;
    color: var(--dalbe-navy) !important;
    font-weight: 700;
    text-decoration: underline;
  }

  /* dalbe: article body styling (sections/main-blog-post.liquid,
     blocks/_blog-post-content.liquid renders article.content raw into
     .blog-post-content) — headings, lead paragraph and callout boxes,
     modeled on medicam3.ro's own article layout.

     Widened from the stock 672px (--normal-content-width, a narrow prose
     token) to 900px so body text actually uses the page — the reference
     site's article column is noticeably wider than Horizon's default,
     and .blog-post-content's width was leaving ~260px of dead margin on
     each side inside an 1190px-wide section. The title banner
     (blocks/group.liquid, id blog-post-title-banner in
     templates/article.json) is matched to the same 900px so the two
     don't visually mismatch — its block-id survives into a stable class
     suffix (__blog-post-title-banner), safe to target directly since
     it's unique to this one block instance, not shared with other
     group blocks on other pages. */
  .blog-post-content,
  [class*="__blog-post-title-banner"] {
    max-width: 900px !important;
    margin-inline: auto !important;
  }

  .blog-post-content h2 {
    margin-block: 2.5rem 1rem;
    padding-block-end: 0.5rem;
    color: var(--dalbe-navy);
    border-block-end: 3px solid var(--dalbe-red);
  }

  .blog-post-content h3 {
    margin-block: 2rem 0.75rem;
    color: var(--dalbe-navy);
  }

  .blog-post-content h4 {
    margin-block: 1.5rem 0.5rem;
    color: var(--dalbe-navy);
  }

  .blog-post-content p {
    line-height: 1.7;
  }

  .blog-post-content > rte-formatter > p:first-of-type {
    background: #f4f5f9;
    border-inline-start: 4px solid var(--dalbe-red);
    border-radius: 0 12px 12px 0;
    padding: 20px 24px;
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .blog-post-content blockquote {
    background: var(--dalbe-navy);
    color: #ffffff;
    margin-block: 1.75rem;
    margin-inline: 0;
    padding: 24px 28px;
    border-radius: 16px;
    font-style: normal;
  }

  .blog-post-content blockquote * {
    color: inherit;
  }

  .blog-post-content blockquote p {
    margin: 0 0 0.5rem;
  }

  .blog-post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  .blog-post-content a {
    color: var(--dalbe-navy) !important;
    font-weight: 700;
    text-decoration: underline;
  }

  /* Yellow callout: warnings/tips/checklists (<aside>, no class needed —
     plain semantic tags are what reliably survive Article body content,
     unlike theme section "text" settings which strip inline style). */
  .blog-post-content aside {
    background: #fdf3d7;
    border-inline-start: 4px solid var(--dalbe-red);
    border-radius: 0 12px 12px 0;
    padding: 20px 24px;
    margin-block: 1.75rem;
  }

  .blog-post-content aside h3,
  .blog-post-content aside h4 {
    margin-block-start: 0;
  }

  .blog-post-content aside p:last-child,
  .blog-post-content aside ol:last-child,
  .blog-post-content aside ul:last-child {
    margin-bottom: 0;
  }

  /* Gray product-recommendation card with a CTA button (<figure>,
     repurposed purely as a distinct, universally-allowed tag to hook
     CSS onto — not used for actual images here). */
  .blog-post-content figure {
    background: #f4f5f9;
    border-inline-start: 4px solid var(--dalbe-red);
    border-radius: 0 16px 16px 0;
    padding: 24px 28px;
    margin-block: 1.75rem;
    margin-inline: 0;
  }

  .blog-post-content figure h3,
  .blog-post-content figure h4 {
    margin-block-start: 0;
  }

  /* Direct-child only — the CTA button, not the inline category link
     that also lives inside the figure's body paragraph. */
  .blog-post-content figure > a {
    display: inline-block;
    margin-block-start: 12px;
    padding: 12px 24px;
    background: var(--dalbe-red);
    color: #ffffff !important;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none !important;
  }

  .blog-post-content figure > a:hover {
    opacity: 0.85;
  }

  /* Full-width navy conclusion block with CTA button (<aside> containing
     an <h2> — the only aside variant that does, since the yellow tip
     boxes only ever use h3/h4 — used as a stable hook instead of a
     class, which Article body content doesn't reliably keep). */
  .blog-post-content aside:has(h2) {
    background: var(--dalbe-navy);
    border-inline-start: none;
    border-radius: 8px;
    padding: 40px;
    margin-block: 3rem 0;
  }

  .blog-post-content aside:has(h2) * {
    color: #ffffff;
  }

  .blog-post-content aside:has(h2) h2 {
    margin-block-start: 0;
    padding-block-end: 0;
    border-block-end: none;
  }

  .blog-post-content aside:has(h2) p a {
    color: var(--dalbe-red) !important;
    font-weight: 600;
    text-decoration: underline;
  }

  .blog-post-content aside:has(h2) > a {
    display: inline-block;
    margin-block-start: 20px;
    padding: 15px 30px;
    background: var(--dalbe-red);
    color: #ffffff !important;
    font-weight: 600;
    border-radius: 5px;
    text-decoration: none !important;
  }

  .blog-post-content aside:has(h2) > a:hover {
    background: #ffffff;
    color: var(--dalbe-navy) !important;
  }

  /* dalbe: Contact page (templates/page.contact.json). The info cards and
     the form card both use plain group blocks (no native shadow setting
     in Horizon), so a matching shadow is added here to keep them visually
     consistent with the rest of the site's card treatment (blog-post-card,
     product-card figures, etc.). */
  [class*="__card-contact"],
  [class*="__card-showroom"],
  [class*="__card-hours"],
  [class*="__form-card"] {
    box-shadow: 0 2px 8px rgba(19, 31, 93, 0.06);
  }

  /* dalbe: custom-liquid blocks render with no .shopify-block wrapper
     (schema sets "tag": null) — the block's own <div> is a bare flex
     item with no width/flex-basis, so it shrinks to its content's
     intrinsic size instead of stretching to the section's width. That
     breaks two things: the map iframe's own `width: 100%` has nothing
     to resolve against, and any inner `justify-content: center` (like
     the NoGag feature-card icons) has no extra space to center within.
     Scoped to custom-liquid's actual output shapes rather than editing
     the stock custom-liquid.liquid block, since that block is shared
     theme-wide. */
  div:has(> iframe[src*="maps.google.com"]),
  div:has(> div > svg),
  div:has(> .dalbe-nogag-compare) {
    width: 100%;
    align-self: stretch;
  }

  /* dalbe: contact page map — wider than the theme's normal page-width
     column but still short of edge-to-edge full-width. --page-width is
     set directly (not derived from --page-content-width at this
     element), so it has to be overridden itself — it's what
     --full-page-grid-central-column-width actually reads. */
  .section[class*="__map"] {
    --page-width: 1500px;
  }

  /* dalbe: NoGag page's 2 reveal cards ("cards" section) — a dedicated
     navy/red palette layered on top of the shared dalbe-process-steps
     component, scoped to this page's section id so Clinica la cheie's
     own (unstyled-panel) use of the same detailed-mode component is
     unaffected. */
  [id*="__cards"] .dalbe-process-steps__item-content {
    background: var(--dalbe-navy);
    padding: 28px !important;
  }

  [id*="__cards"] .dalbe-process-steps__item-content * {
    color: #ffffff;
  }

  [id*="__cards"] .dalbe-process-steps__body ul,
  [id*="__cards"] .dalbe-process-steps__body ol {
    margin: 0 0 var(--margin-sm);
    padding-inline-start: 1.25em;
  }

  [id*="__cards"] .dalbe-process-steps__body li {
    margin-block-end: 4px;
  }

  [id*="__cards"] .dalbe-process-steps__body p {
    margin: 0 0 var(--margin-xs, 8px);
  }

  [id*="__cards"] .dalbe-process-steps__number {
    background: var(--dalbe-red);
  }

  /* "Cum se folosește" step's 3-icon composite (custom_media override on
     dalbe-process-step, since the block's normal media slot only takes a
     single image) — navy panel with 3 white circular photo badges,
     matching the real site's 3-illustration media side. */
  .dalbe-nogag-howto-media {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 3vw, 32px);
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: var(--dalbe-navy);
    padding: 24px;
    box-sizing: border-box;
  }

  .dalbe-nogag-howto-media__circle {
    flex: 0 1 160px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffffff;
    overflow: hidden;
  }

  .dalbe-nogag-howto-media__circle img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .dalbe-nogag-howto-media__circle {
      flex-basis: 100px;
    }
  }

  /* NoGag "Validare Științifică" section — plain static content (no
     scroll-reveal animation, unlike the two dalbe-process-steps cards
     above it), just a small navy accent bar on the heading and tighter
     list spacing to match the real site's plain bullet list. */
  [id*="__validation"] h2 {
    border-inline-start: 4px solid var(--dalbe-navy);
    padding-inline-start: 12px;
  }

  [id*="__validation"] ul {
    margin: 0 0 var(--margin-sm, 8px);
    padding-inline-start: 1.25em;
  }

  [id*="__cards"] .dalbe-process-steps__cta.button {
    background: var(--dalbe-red);
    border-color: var(--dalbe-red);
    color: #ffffff !important;
  }

  /* NoGag "NoGag vs. Anestezie locală" comparison — two side-by-side
     mini tables (not a single merged 4-column table), matching the real
     site's layout: a solid header bar per table, zebra-striped rows
     below it. */
  .dalbe-nogag-compare {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .dalbe-nogag-compare__table {
    flex: 1 1 320px;
    border-collapse: collapse;
    width: 100%;
  }

  .dalbe-nogag-compare__table th {
    background: var(--dalbe-navy);
    color: #ffffff;
    text-align: left;
    font-size: 1.0625rem;
    font-weight: 700;
    padding: 16px 20px;
  }

  .dalbe-nogag-compare__table td {
    padding: 14px 20px;
    color: var(--dalbe-text, #222222);
  }

  .dalbe-nogag-compare__table td:first-child {
    font-weight: 600;
  }

  .dalbe-nogag-compare__table td:last-child {
    text-align: right;
  }

  .dalbe-nogag-compare__table tbody tr:nth-child(even) {
    background: #f4f5f9;
  }

  /* Wider than the theme's normal page-width column so each table's
     value column has room to breathe instead of wrapping labels like
     "Necesită supraveghere?" onto two lines. Same override technique as
     the contact page's map section. */
  .section[class*="__comparison"] {
    --page-width: 1700px;
  }

  /* NoGag FAQ accordion — real color/weight instead of Horizon's plain
     text-on-white default: gray rows at rest, navy fill + white text on
     the open row, matching the real site's treatment. */
  [id*="__faq"] .details {
    background: #f4f5f9;
    border-radius: 12px;
    margin-block-end: 12px;
    overflow: hidden;
    transition: background-color var(--animation-speed-slow, 0.4s) var(--animation-easing, ease);
  }

  [id*="__faq"] .details[open] {
    background: var(--dalbe-navy);
  }

  /* The accordion component only animates open/close for the item the
     user directly interacted with (:focus-within) — when our exclusive-
     accordion script force-closes the OTHER open item, it has no focus
     and so has no transition, snapping shut instantly while the newly
     opened one animates smoothly. That mismatch is what reads as
     "jumpy". Force the transition on regardless of focus, scoped to
     this page's FAQ only. */
  [id*="__faq"] .details:not(:focus-within) .details-content {
    transition:
      content-visibility var(--animation-speed-slow) allow-discrete,
      padding-block var(--animation-speed-slow) var(--animation-easing),
      opacity var(--animation-speed-slow) var(--animation-easing),
      block-size var(--animation-speed-slow) var(--animation-easing) !important;
  }

  [id*="__faq"] .details[open] * {
    color: #ffffff;
  }

  [id*="__faq"] .details__header {
    padding: 18px 24px;
    font-weight: 700;
    cursor: pointer;
  }

  [id*="__faq"] .details-content {
    padding-inline: 24px;
    padding-block: 4px 20px;
  }

  [id*="__faq"] .details-content > * {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
  }

  [id*="__faq"] .details-content p {
    margin: 0;
    text-align: left;
    font-weight: 400;
    line-height: 1.6;
  }

  /* dalbe: collection page filter sidebar reskin. Scoped to <results-list>
     (dalbe-collection.liquid's own root element, forked from Horizon's
     main-collection) — this markup only ever renders on the collection
     template. The product cards themselves are fully custom markup with
     their own scoped styles in dalbe-collection.liquid directly; this block
     is just for Horizon's native vertical filters sidebar, which is kept
     as real, working native filtering/sorting/pagination — visual reskin
     only, matching the navy/red brand language used everywhere else. */
  results-list.product-grid-container .facets--vertical {
    background: #fff;
    border: 1px solid #eef0f5;
    border-radius: 12px;
    padding: 20px;
  }

  results-list.product-grid-container .facets__summary {
    color: var(--dalbe-navy);
    font-weight: 700;
    font-size: 0.9375rem;
    padding-block: 12px;
  }

  results-list.product-grid-container .facets__label {
    color: var(--dalbe-navy);
    font-weight: 700;
  }

  results-list.product-grid-container .facets__panel:not(:last-child) {
    border-block-end: 1px solid #eef0f5;
  }

  results-list.product-grid-container .facets input[type="checkbox"]:checked,
  results-list.product-grid-container .facets input[type="radio"]:checked {
    accent-color: var(--dalbe-red);
  }

  results-list.product-grid-container .facets-vertical-sort select,
  results-list.product-grid-container .facets a {
    color: var(--dalbe-navy);
  }

  results-list.product-grid-container .facets__clear-all-link {
    color: var(--dalbe-red) !important;
  }

  /* dalbe: shared, global product card design -- single source of truth for
     every "product card" on the site (collection grid, homepage carousels,
     product recommendations, cart/404 "you may also like", search results).
     Lives here (rendered globally from layout/theme.liquid) rather than in
     any one section's own stylesheet block, since Shopify sections can't
     share a stylesheet with each other and this design now needs to be
     available in many different section/block files at once. Markup comes
     from snippets/dalbe-product-card.liquid. */
  .dalbe-product-card {
    position: relative;
    height: 100%;
    background: #fff;
    border: 1px solid #eef0f5;
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(19, 31, 93, 0.06);
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .dalbe-product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--dalbe-navy);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .dalbe-product-card:hover {
    transform: translateY(-3px);
    border-color: var(--dalbe-navy);
    box-shadow: 0 10px 24px rgba(19, 31, 93, 0.14);
  }

  .dalbe-product-card:hover::before {
    transform: scaleX(1);
  }

  .dalbe-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--dalbe-red);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .dalbe-product-card__badge--sold-out {
    background: #6b7280;
  }

  .dalbe-product-card__link {
    text-decoration: none;
    display: block;
  }

  .dalbe-product-card__img-wrap {
    width: calc(100% + 32px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: -16px -16px 12px;
    padding: 16px;
    /* dalbe: white, not the previous light-lilac gradient. Nearly every
       product photo in this catalog ships with its own white studio
       background baked into the file, so a tinted panel behind them made
       each photo's own white rectangle visible as a distinct block --
       and since those rectangles differ in proportion product to product,
       the grid read as "every image is a different size" even though the
       tiles themselves are identical 1:1 boxes. Matching the panel to the
       photos' own background makes them blend, so only the product is
       visible and the row looks uniform. */
    background: #ffffff;
  }

  .dalbe-product-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.25s ease;
  }

  .dalbe-product-card:hover .dalbe-product-card__img-wrap img {
    transform: scale(1.05);
  }

  /* dalbe: product-page gallery must never enlarge a photo past its own
     resolution. The gallery column renders ~571px wide, but most of this
     catalog's product shots are only ~483px square, and both `cover` and
     `contain` scale a small image UP to fill the box -- so those photos
     were being blown up ~18% and going visibly soft/pixelated (reported
     by the client, who confirmed no higher-res originals exist).

     `scale-down` is the one object-fit value that fixes this: it behaves
     exactly like `contain` for images larger than the box, but leaves
     anything smaller at its native size instead of upscaling. Oversized
     photos still shrink to fit; undersized ones now sit centred at 1:1
     and stay sharp.

     Scoped to <media-gallery> (product page only) so product cards --
     which share .product-media-container via card-gallery.liquid, and
     genuinely do want to fill their tile -- are untouched. The doubled
     class in each selector is deliberate: Horizon's own
     `.media-fit-cover :is(img, video, iframe, .deferred-media__poster-image)`
     scores (0,2,0) and already beats the theme's own
     `.product-media-container img` contain rule, so a plainer selector
     here would silently lose too. */
  media-gallery .product-media-container.media-fit-cover img,
  media-gallery .product-media-container.media-fit-contain img,
  media-gallery .product-media-container.media-fit img {
    object-fit: scale-down;
  }

  .dalbe-product-card__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #2d3748;
    line-height: 1.35;
    margin: 0 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
    transition: color 0.2s ease;
  }

  .dalbe-product-card:hover .dalbe-product-card__name {
    color: var(--dalbe-navy);
  }

  .dalbe-product-card__price {
    color: var(--dalbe-navy);
    font-size: 1.0625rem;
    font-weight: 800;
    margin: 0 0 12px;
  }

  .dalbe-product-card__price del {
    color: #9aa1b3;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: line-through;
    margin-inline-end: 4px;
    display: inline-block;
  }

  .dalbe-product-card__price ins {
    color: var(--dalbe-red);
    text-decoration: none;
  }

  .dalbe-product-card__bottom {
    margin-top: auto;
  }

  .dalbe-product-card__form,
  .dalbe-product-card__form product-form-component {
    display: block;
    width: 100%;
  }

  .dalbe-product-card .add-to-cart-button {
    width: 100%;
    background: var(--dalbe-red) !important;
    color: #fff !important;
    border-radius: 999px !important;
    font-size: 0.8125rem !important;
    font-weight: 700 !important;
    padding: 10px 14px !important;
    border: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .dalbe-product-card .add-to-cart-icon svg {
    width: 14px;
    height: 14px;
  }

  /* dalbe: product page (PDP) "pop" reskin -- global CSS layer on top of the
     native product-information section, which stays fully in place for all
     commerce logic (variant picker, buy buttons, checkout, gift cards,
     sticky add to cart). Only visuals are overridden here. */
  .product-information__media media-gallery {
    border-radius: 18px;
    overflow: hidden;
  }

  .product-information__media .product-media-container {
    border-radius: 18px;
    background: linear-gradient(180deg, #f4f5fb 0%, #eceefa 100%);
  }

  .product-details div:has(> .compare-at-price) > .price-item__group.price:not(.price-item--regular) {
    color: var(--dalbe-red);
  }

  .product-details .compare-at-price {
    color: #9aa1b3;
    font-weight: 500;
  }

  .product-inventory__text {
    font-weight: 600;
  }

  /* dalbe: the pill is the sliding element that paints the SELECTED
     variant's fill; it sits inside the button and must follow the
     button's own corner radius. This used to force 999px (a stadium),
     left over from when these buttons were themselves pill-shaped --
     they're now 14px (settings_data.json → variant_button_radius), so a
     999px fill curved away from the corners and left white crescents
     inside the outline, especially at the short left/right ends where a
     999px radius resolves to a half-circle. Invisible while the selected
     fill was pale lilac; obvious the moment it became solid navy.

     `inherit` tracks whatever variant_button_radius is set to, so this
     can't drift out of sync again if that setting changes. */
  .product-details .variant-option__button-label__pill {
    border-radius: inherit;
  }

  .product-details .buy-buttons .add-to-cart-button {
    border-radius: 999px !important;
    font-weight: 700 !important;
    box-shadow: 0 10px 24px rgba(233, 50, 78, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-details .buy-buttons .add-to-cart-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(233, 50, 78, 0.32);
  }

  .product-details .icon-block {
    background: var(--dalbe-navy);
    border-radius: 50%;
    padding: 10px;
  }

  .product-details .text-block.rte {
    line-height: 1.7;
  }

  .product-details .text-block.rte :is(h1, h2, h3, h4, h5, h6) {
    color: var(--dalbe-navy);
  }

  .product-details .text-block.rte strong,
  .product-details .text-block.rte b {
    color: var(--dalbe-navy);
  }

  .product-details .text-block.rte ul,
  .product-details .text-block.rte ol {
    padding-inline-start: 1.2em;
  }

  .product-details .text-block.rte li::marker {
    color: var(--dalbe-red);
  }

  .dalbe-product-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .dalbe-product-brand:hover {
    opacity: 0.75;
  }

  .dalbe-product-brand:hover .dalbe-product-brand__name {
    text-decoration: underline;
  }

  .dalbe-product-brand__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #2d3748;
  }

  .dalbe-product-brand__logo {
    display: flex;
    flex-shrink: 0;
  }

  .dalbe-product-brand__logo img {
    display: block;
    width: auto;
    height: 44px;
    max-width: 160px;
    object-fit: contain;
  }

  .dalbe-product-brand__name {
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dalbe-red);
  }

  .dalbe-product-sku {
    margin: 0;
    font-size: 0.875rem;
  }

  .dalbe-product-sku__label {
    font-weight: 600;
    color: #2d3748;
  }

  .dalbe-product-sku__value {
    color: #6b7280;
  }

  .dalbe-product-wishlist {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #2d3748;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .dalbe-product-wishlist .svg-wrapper svg {
    width: 20px;
    height: 20px;
  }

  .dalbe-product-wishlist:hover {
    color: var(--dalbe-red);
  }
{% endstyle %}
