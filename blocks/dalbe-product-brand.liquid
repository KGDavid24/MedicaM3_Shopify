{%- doc -%}
  PDP "brand" block -- links to that brand's filtered product list. Shows
  the real manufacturer logo when a matching brand_logo metaobject has
  one; the logo's own wordmark already spells out the brand name, so the
  plain-text name is only shown as a fallback when no logo exists
  (otherwise the name would visibly repeat right next to its own logo).
  Same lookup pattern as the auto-mode Branduri directory
  (sections/dalbe-brand-directory.liquid) -- both match against
  product.vendor / the native vendor filter label, which are the same
  underlying string.
{%- enddoc -%}

{% liquid
  assign vendor_name = closest.product.vendor
  assign matched_logo = null
  if vendor_name != blank
    for logo_entry in metaobjects.brand_logo.values
      if logo_entry.name.value == vendor_name
        assign matched_logo = logo_entry
        break
      endif
    endfor
  endif
  assign has_logo = false
  if matched_logo and matched_logo.logo.value
    assign has_logo = true
  endif
  assign encoded_vendor = vendor_name | url_encode
  assign brand_href = routes.all_products_collection_url | append: '?filter.p.vendor=' | append: encoded_vendor
%}

{% if vendor_name != blank %}
  <a href="{{ brand_href }}" class="dalbe-product-brand">
    <span class="dalbe-product-brand__label">Brand:</span>
    {% if has_logo %}
      <span class="dalbe-product-brand__logo">
        {{ matched_logo.logo.value | image_url: width: 300 | image_tag: loading: 'lazy', alt: vendor_name, sizes: null, widths: null }}
      </span>
    {% else %}
      <span class="dalbe-product-brand__name">{{ vendor_name }}</span>
    {% endif %}
  </a>
{% endif %}

{% schema %}
{
  "name": "Brand produs (custom)",
  "tag": null,
  "settings": []
}
{% endschema %}
