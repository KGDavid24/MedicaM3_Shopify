{%- doc -%}
  Homepage CTA pointing at the regional reps page
  (templates/page.reprezentanti.json). Sits between the navy "Clinică la
  cheie" experience CTA and the newsletter block.

  Deliberately light rather than navy: the section directly above it is a
  full-bleed navy panel, so a second dark band would read as one
  over-long block and lose the CTA entirely. A white card with a navy
  rule and red button keeps it distinct from both its neighbours (the
  newsletter below sits on a tinted panel, this one on white).
{%- enddoc -%}

{% liquid
  assign cta_link = section.settings.link
  if cta_link == blank
    assign cta_link = '/pages/reprezentanti'
  endif
%}

<div class="dalbe-reprezentanti-cta">
  <div class="dalbe-reprezentanti-cta__inner">
    <span class="dalbe-reprezentanti-cta__icon" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    </span>

    <div class="dalbe-reprezentanti-cta__body">
      {% if section.settings.heading != blank %}
        <h2 class="dalbe-reprezentanti-cta__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="dalbe-reprezentanti-cta__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank %}
      <a href="{{ cta_link }}" class="dalbe-reprezentanti-cta__button">
        {{ section.settings.button_label | escape }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .dalbe-reprezentanti-cta {
    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
  }

  .dalbe-reprezentanti-cta__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 28px 32px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    /* dalbe: the navy edge is what stops this reading as another plain
       card — it echoes the panel above without repeating its weight. */
    border-inline-start: 4px solid var(--dalbe-navy);
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(19, 31, 93, 0.06);
  }

  .dalbe-reprezentanti-cta__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgb(19 31 93 / 0.07);
    color: var(--dalbe-navy);
  }

  .dalbe-reprezentanti-cta__body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .dalbe-reprezentanti-cta__heading {
    margin: 0 0 4px;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--dalbe-navy);
    line-height: 1.25;
  }

  .dalbe-reprezentanti-cta__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--dalbe-text, #222222);
  }

  .dalbe-reprezentanti-cta__button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    background: var(--dalbe-red);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .dalbe-reprezentanti-cta__button:hover {
    background: #c92440;
  }

  /* dalbe: the row needs ~700px to hold icon + copy + a nowrap button
     side by side. Below that it stacks and centres — the button goes
     full-width so it stays an obvious tap target rather than a stray
     pill floating under left-aligned text. */
  @media screen and (max-width: 749px) {
    .dalbe-reprezentanti-cta {
      margin: 28px auto;
    }

    .dalbe-reprezentanti-cta__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 16px;
      padding: 24px 20px;
      /* dalbe: a 4px left edge on a narrow stacked card reads as a
         rendering artefact; move the accent to the top instead. */
      border-inline-start: 1px solid #e5e7eb;
      border-block-start: 4px solid var(--dalbe-navy);
    }

    .dalbe-reprezentanti-cta__heading {
      font-size: 1.1875rem;
    }

    .dalbe-reprezentanti-cta__text {
      font-size: 0.875rem;
    }

    .dalbe-reprezentanti-cta__button {
      width: 100%;
      justify-content: center;
      padding-block: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reprezentanti CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Caută reprezentantul din zona ta"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Echipa noastră de vânzări acoperă toată țara. Vezi pe hartă cine se ocupă de județul tău și ia legătura direct."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text buton",
      "default": "Vezi reprezentanții"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link buton",
      "info": "Implicit: pagina Reprezentanți Zonali."
    }
  ],
  "presets": [
    {
      "name": "Reprezentanti CTA"
    }
  ]
}
{% endschema %}
