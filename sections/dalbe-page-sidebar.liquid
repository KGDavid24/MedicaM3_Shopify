{%- doc -%}
  A page layout with a fixed-width "Ghid Client" sidebar nav (see
  snippets/dalbe-sidebar-nav-list.liquid) beside a merchant-editable content
  column. Used by the info/policy pages that get real Liquid templates in
  this project (About, Services, Cookie policy) — the native Shopify
  Policies pages the sidebar also links to do NOT use this section, since
  Shopify renders those through its own fixed, non-templatable layout.

  Deliberately mirrors main-page.liquid's block-driven content column
  (title + page-content blocks via {% content_for 'blocks' %}) so page body
  copy stays editable in Shopify Admin exactly like a normal page, and uses
  Horizon's simpler page-width-content width constraint rather than the
  vw-based alignment formulas the homepage sections use — this page has no
  cross-section edge-alignment requirement.
{%- enddoc -%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="dalbe-page-sidebar__row"
    style="--dalbe-page-sidebar-gap: {{ section.settings.sidebar_gap }}px;"
  >
    <nav
      class="dalbe-page-sidebar__nav"
      aria-label="{{ 'accessibility.secondary_navigation' | t | default: 'Ghid client' }}"
    >
      {% render 'dalbe-sidebar-nav-list' %}
    </nav>

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
        dalbe-page-sidebar__content
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .dalbe-page-sidebar__row {
    display: flex;
    align-items: flex-start;
    gap: var(--dalbe-page-sidebar-gap, 48px);
  }

  .dalbe-page-sidebar__nav {
    flex: 0 0 280px;
    width: 280px;
  }

  .dalbe-page-sidebar__content {
    flex: 1 1 auto;
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .dalbe-page-sidebar__row {
      flex-direction: column;
    }

    .dalbe-page-sidebar__nav {
      flex: 1 1 auto;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page with sidebar nav",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "sidebar_gap",
      "label": "Gap between sidebar and content",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Page with sidebar nav",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h1>{{ closest.page.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2"
          }
        },
        "page-content": {
          "type": "page-content"
        }
      },
      "block_order": ["heading", "page-content"]
    }
  ]
}
{% endschema %}
