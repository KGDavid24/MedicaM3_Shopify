{%- doc -%}
  Branduri — an A-Z brand directory. Two data sources, picked automatically:

  - `auto` (default): reads the native Product Vendor filter from
    collections.all.filters (Shopify/Search & Discovery's own server-side
    vendor aggregation — {label, count, url_to_add} per unique vendor, no
    Liquid loop over the product catalog). Requires Search & Discovery's
    Vendor filter to be enabled on the storefront; falls through to the
    manual list below if it isn't (or returns no values yet).
  - `manual`: a repeatable `dalbe-brand-entry` block (name + optional url),
    for seeding known brand names as real content before product/vendor
    data exists. No product counts shown in this mode.
{%- enddoc -%}

{% liquid
  assign vendor_filter = null
  for filter in collections.all.filters
    if filter.param_name != blank and filter.param_name contains 'vendor'
      assign vendor_filter = filter
      break
    endif
  endfor

  assign use_auto = false
  if section.settings.data_source == 'auto' and vendor_filter != null and vendor_filter.values.size > 0
    assign use_auto = true
  endif
%}

<div class="dalbe-brand-directory section section--page-width">
  {% if section.settings.heading != blank %}
    <h1 class="dalbe-brand-directory__heading">{{ section.settings.heading }}</h1>
  {% endif %}

  {% if use_auto %}
    {% assign sorted_values = vendor_filter.values | sort_natural: 'label' %}

    {% assign seen_letters = '' %}
    <nav class="dalbe-brand-directory__jump" aria-label="{{ 'accessibility.secondary_navigation' | t | default: 'Salt la litera' }}">
      {% for value in sorted_values %}
        {% assign letter = value.label | slice: 0, 1 | upcase %}
        {% unless seen_letters contains letter %}
          {% assign seen_letters = seen_letters | append: letter | append: ',' %}
          <a href="#dalbe-brand-letter-{{ letter }}" class="dalbe-brand-directory__jump-link">{{ letter }}</a>
        {% endunless %}
      {% endfor %}
    </nav>

    {% assign current_letter = '' %}
    <div class="dalbe-brand-directory__list">
      {% for value in sorted_values %}
        {% assign letter = value.label | slice: 0, 1 | upcase %}
        {% if letter != current_letter %}
          {% unless current_letter == '' %}
            </ul>
          {% endunless %}
          <h2 id="dalbe-brand-letter-{{ letter }}" class="dalbe-brand-directory__letter">{{ letter }}</h2>
          <ul class="dalbe-brand-directory__group list-unstyled">
          {% assign current_letter = letter %}
        {% endif %}
        <li class="dalbe-brand-directory__item">
          <a href="{{ value.url_to_add }}" class="dalbe-brand-directory__link">
            <span>{{ value.label }}</span>
            <span class="dalbe-brand-directory__count">{{ value.count }}</span>
          </a>
        </li>
      {% endfor %}
      </ul>
    </div>
  {% else %}
    <ul class="dalbe-brand-directory__list dalbe-brand-directory__list--manual list-unstyled">
      {% for block in section.blocks %}
        {% if block.type == 'dalbe-brand-entry' %}
          <li class="dalbe-brand-directory__item" {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}" class="dalbe-brand-directory__link">
                <span>{{ block.settings.name }}</span>
              </a>
            {% else %}
              <span class="dalbe-brand-directory__link dalbe-brand-directory__link--static">
                <span>{{ block.settings.name }}</span>
              </span>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .dalbe-brand-directory {
    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
    padding-block: var(--padding-xl);
  }

  .dalbe-brand-directory__heading {
    margin: 0 0 var(--margin-lg);
  }

  .dalbe-brand-directory__jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    margin-block-end: var(--margin-xl);
    position: sticky;
    top: var(--header-group-height, 0px);
    background: var(--color-background);
    z-index: 1;
    padding-block: var(--padding-sm);
  }

  .dalbe-brand-directory__jump-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    color: var(--dalbe-navy);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .dalbe-brand-directory__jump-link:hover {
    background: rgb(19 31 93 / 0.08);
  }

  .dalbe-brand-directory__letter {
    color: var(--dalbe-navy);
    font-size: 1.25rem;
    margin-block: var(--margin-lg) var(--margin-sm);
    scroll-margin-top: calc(var(--header-group-height, 0px) + 48px);
  }

  .dalbe-brand-directory__group,
  .dalbe-brand-directory__list--manual {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px var(--gap-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dalbe-brand-directory__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-xs);
    padding-block: 4px;
    color: var(--dalbe-text, #222222);
    text-decoration: none;
  }

  .dalbe-brand-directory__link:hover {
    color: var(--dalbe-navy);
  }

  .dalbe-brand-directory__count {
    color: var(--color-foreground-secondary, #666666);
    font-size: 0.8125rem;
  }

  @media screen and (max-width: 989px) {
    .dalbe-brand-directory__group,
    .dalbe-brand-directory__list--manual {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .dalbe-brand-directory__group,
    .dalbe-brand-directory__list--manual {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand directory",
  "tag": "div",
  "class": "dalbe-brand-directory-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Branduri"
    },
    {
      "type": "select",
      "id": "data_source",
      "label": "Data source",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (native vendor filter)"
        },
        {
          "value": "manual",
          "label": "Manual list"
        }
      ],
      "default": "auto",
      "info": "Automatic reads the storefront's native Product Vendor filter (Search & Discovery) with live product counts. Falls back to the manual list below until that filter has data."
    }
  ],
  "blocks": [
    {
      "type": "dalbe-brand-entry",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Optional — leave blank to show the name without a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand directory"
    }
  ]
}
{% endschema %}
