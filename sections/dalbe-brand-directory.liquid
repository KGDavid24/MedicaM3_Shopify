{%- doc -%}
  Branduri — an A-Z brand directory. Two data sources, picked automatically:

  - `auto` (default): reads the native Product Vendor filter from
    collections.all.filters (Shopify/Search & Discovery's own server-side
    vendor aggregation — {label, count, url_to_add} per unique vendor, no
    Liquid loop over the product catalog). Requires Search & Discovery's
    Vendor filter to be enabled on the storefront; falls through to the
    manual list below if it isn't (or returns no values yet).
  - `manual`: a repeatable `dalbe-brand-entry` block (name + optional url),
    for seeding known brand names as real content before product/vendor
    data exists. No product counts shown in this mode.
{%- enddoc -%}

{% liquid
  assign vendor_filter = null
  for filter in collections.all.filters
    if filter.param_name != blank and filter.param_name contains 'vendor'
      assign vendor_filter = filter
      break
    endif
  endfor

  assign use_auto = false
  if section.settings.data_source == 'auto' and vendor_filter != null and vendor_filter.values.size > 0
    assign use_auto = true
  endif
%}

<div class="dalbe-brand-directory section section--page-width">
  {% if section.settings.heading != blank %}
    <h1 class="dalbe-brand-directory__heading">{{ section.settings.heading }}</h1>
  {% endif %}

  {% if use_auto %}
    {% assign sorted_values = vendor_filter.values | sort_natural: 'label' %}

    {% assign seen_letters = '' %}
    <nav class="dalbe-brand-directory__jump" aria-label="{{ 'accessibility.secondary_navigation' | t | default: 'Salt la litera' }}">
      {% for value in sorted_values %}
        {% assign letter = value.label | slice: 0, 1 | upcase %}
        {% unless seen_letters contains letter %}
          {% assign seen_letters = seen_letters | append: letter | append: ',' %}
          <a href="#dalbe-brand-letter-{{ letter }}" class="dalbe-brand-directory__jump-link">{{ letter }}</a>
        {% endunless %}
      {% endfor %}
    </nav>

    {% assign current_letter = '' %}
    <div class="dalbe-brand-directory__list">
      {% for value in sorted_values %}
        {% assign letter = value.label | slice: 0, 1 | upcase %}
        {% if letter != current_letter %}
          {% unless current_letter == '' %}
            </ul>
          {% endunless %}
          <h2 id="dalbe-brand-letter-{{ letter }}" class="dalbe-brand-directory__letter">{{ letter }}</h2>
          <ul class="dalbe-brand-directory__group list-unstyled">
          {% assign current_letter = letter %}
        {% endif %}
        {% liquid
          assign brand_initial = value.label | slice: 0, 1 | upcase
          assign matched_logo = null
          for logo_entry in metaobjects.brand_logo.values
            if logo_entry.name.value == value.label
              assign matched_logo = logo_entry
              break
            endif
          endfor
          assign encoded_vendor = value.label | url_encode
          assign card_href = routes.all_products_collection_url | append: '?filter.p.vendor=' | append: encoded_vendor
        %}
        <li class="dalbe-brand-directory__item">
          <a href="{{ card_href }}" class="dalbe-brand-directory__card">
            <span class="dalbe-brand-directory__logo">
              {% if matched_logo and matched_logo.logo.value %}
                {{ matched_logo.logo.value | image_url: width: 240 | image_tag: class: 'dalbe-brand-directory__logo-img', loading: 'lazy', alt: value.label }}
              {% else %}
                <span class="dalbe-brand-directory__placeholder">{{ brand_initial }}</span>
              {% endif %}
            </span>
            <span class="dalbe-brand-directory__info">
              <span class="dalbe-brand-directory__name">{{ value.label }}</span>
              <span class="dalbe-brand-directory__count">{{ value.count }} produse</span>
            </span>
          </a>
        </li>
      {% endfor %}
      </ul>
    </div>
  {% else %}
    <ul class="dalbe-brand-directory__list dalbe-brand-directory__list--manual list-unstyled">
      {% for block in section.blocks %}
        {% if block.type == 'dalbe-brand-entry' %}
          {% liquid
            assign brand_initial = block.settings.name | slice: 0, 1 | upcase
          %}
          <li class="dalbe-brand-directory__item" {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}" class="dalbe-brand-directory__card">
                <span class="dalbe-brand-directory__logo">
                  {% if block.settings.logo %}
                    {{ block.settings.logo | image_url: width: 240 | image_tag: class: 'dalbe-brand-directory__logo-img', loading: 'lazy', alt: block.settings.name }}
                  {% else %}
                    <span class="dalbe-brand-directory__placeholder">{{ brand_initial }}</span>
                  {% endif %}
                </span>
                <span class="dalbe-brand-directory__info">
                  <span class="dalbe-brand-directory__name">{{ block.settings.name }}</span>
                </span>
              </a>
            {% else %}
              <span class="dalbe-brand-directory__card dalbe-brand-directory__card--static">
                <span class="dalbe-brand-directory__logo">
                  {% if block.settings.logo %}
                    {{ block.settings.logo | image_url: width: 240 | image_tag: class: 'dalbe-brand-directory__logo-img', loading: 'lazy', alt: block.settings.name }}
                  {% else %}
                    <span class="dalbe-brand-directory__placeholder">{{ brand_initial }}</span>
                  {% endif %}
                </span>
                <span class="dalbe-brand-directory__info">
                  <span class="dalbe-brand-directory__name">{{ block.settings.name }}</span>
                </span>
              </span>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .dalbe-brand-directory {
    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
    padding-block: var(--padding-xl);
  }

  .dalbe-brand-directory__heading {
    margin: 0 0 var(--margin-lg);
  }

  .dalbe-brand-directory__jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    margin-block-end: var(--margin-xl);
    position: sticky;
    top: var(--header-group-height, 0px);
    background: var(--dalbe-navy);
    border-radius: 8px;
    z-index: 1;
    padding: var(--padding-sm) 12px;
  }

  .dalbe-brand-directory__jump-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .dalbe-brand-directory__jump-link:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .dalbe-brand-directory__letter {
    color: var(--dalbe-navy);
    font-size: 1.25rem;
    margin-block: var(--margin-lg) var(--margin-sm);
    scroll-margin-top: calc(var(--header-group-height, 0px) + 48px);
  }

  .dalbe-brand-directory__group,
  .dalbe-brand-directory__list--manual {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }

  .dalbe-brand-directory__item {
    display: flex;
  }

  .dalbe-brand-directory__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 16px 10px;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  a.dalbe-brand-directory__card:hover {
    border-color: var(--dalbe-navy);
    box-shadow: 0 8px 20px rgba(19, 31, 93, 0.1);
    transform: translateY(-2px);
  }

  .dalbe-brand-directory__logo {
    width: 120px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dalbe-brand-directory__logo-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .dalbe-brand-directory__placeholder {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #f3f4f6;
    color: var(--dalbe-navy);
    font-size: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dalbe-brand-directory__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .dalbe-brand-directory__name {
    font-size: 15px;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 4px;
  }

  .dalbe-brand-directory__count {
    font-size: 13px;
    color: #9ca3af;
    font-weight: 400;
  }

  @media screen and (max-width: 989px) {
    .dalbe-brand-directory__group,
    .dalbe-brand-directory__list--manual {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .dalbe-brand-directory__group,
    .dalbe-brand-directory__list--manual {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand directory",
  "tag": "div",
  "class": "dalbe-brand-directory-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Branduri"
    },
    {
      "type": "select",
      "id": "data_source",
      "label": "Data source",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (native vendor filter)"
        },
        {
          "value": "manual",
          "label": "Manual list"
        }
      ],
      "default": "auto",
      "info": "Automatic reads the storefront's native Product Vendor filter (Search & Discovery) with live product counts. Falls back to the manual list below until that filter has data."
    }
  ],
  "blocks": [
    {
      "type": "dalbe-brand-entry",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional — falls back to a letter-avatar circle (matching medicam3.ro's own treatment for brands without an uploaded logo) if left blank."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Optional — leave blank to show the name without a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand directory"
    }
  ]
}
{% endschema %}
