{%- doc -%}
  A custom header replacing Horizon's stock one, matching the source site's
  layout: logo, an always-visible search bar (not an icon-triggered popup),
  a phone number, and three labeled actions (Wishlist / Contul meu / Coș).
  Simplified from the source in two ways: cart and account are plain links
  to the real cart/account pages rather than a drawer/popover, so this
  doesn't need to reimplement Horizon's own cart-drawer or account
  components — clicking them still works correctly, just as a normal page
  navigation instead of an overlay. Wishlist has no real functionality
  behind it (no wishlist app installed) — it's a styled placeholder link
  (`/pages/404-placeholder`, this project's standing convention for "not a
  real destination yet"), included to match the reference site's header,
  not a working feature.
{%- enddoc -%}

{% liquid
  assign alt_text_fallback = 'accessibility.home_logo_alt' | t: store_name: shop.name
  assign phone_href = section.settings.phone_number | remove: ' ' | remove: '.' | remove: '-'
%}

<header class="dalbe-header">
  <div class="dalbe-header__inner section section--full-width">
    <div class="dalbe-header__row">
    <div class="dalbe-header__brand">
      <a href="{{ routes.root_url }}" class="dalbe-header__logo">
        {% render 'image',
          image: settings.logo,
          class: 'dalbe-header__logo-image',
          height: 52,
          alt_text_fallback: alt_text_fallback,
          text_fallback: shop.name
        %}
      </a>
    </div>

    <div class="dalbe-header__middle">
      {% render 'pills-styles' %}
      {% render 'predictive-search-styles' %}
      <predictive-search-component
        class="dalbe-header__search predictive-search"
        data-section-id="predictive-search"
        style="--product-corner-radius: 8px; --card-corner-radius: 8px;"
        role="search"
        aria-label="{{ 'content.search_input_label' | t }}"
      >
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="dalbe-header__search-form predictive-search-form"
          ref="form"
          on:keydown="/onSearchKeyDown"
        >
          <input
            type="search"
            name="q"
            class="dalbe-header__search-input search-input"
            placeholder="{{ section.settings.search_placeholder }}"
            value="{{ search.terms | escape }}"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            ref="searchInput"
            on:input="/search"
            on:keydown="/onSearchKeyDown"
          >
          <button
            type="button"
            class="dalbe-header__search-reset"
            ref="resetButton"
            hidden
            on:click="/resetSearch"
            aria-label="{{ 'actions.clear' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
          </button>
          <button type="submit" class="dalbe-header__search-submit" aria-label="{{ 'general.search.submit' | t | default: 'Search' }}">
            {{ 'icon-search.svg' | inline_asset_content }}
          </button>

          <div class="dalbe-header__search-results-wrapper">
            <div class="dalbe-header__search-results predictive-search-form__content" ref="predictiveSearchResults"></div>
          </div>
        </form>
      </predictive-search-component>
      <script src="{{ 'predictive-search.js' | asset_url }}" type="module" fetchpriority="low"></script>

      {% if section.settings.phone_number != blank %}
        <a href="tel:{{ phone_href }}" class="dalbe-header__phone">
          <span class="svg-wrapper" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z"/>
            </svg>
          </span>
          <span class="dalbe-header__phone-text">
            <small>{{ section.settings.phone_label }}</small>
            {{ section.settings.phone_number }}
          </span>
        </a>
      {% endif %}
    </div>

    <div class="dalbe-header__actions">
      <a href="/pages/404-placeholder" class="dalbe-header__action dalbe-header__action--wishlist">
        <span class="svg-wrapper" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 20.5s-7.5-4.6-10-9.3C.6 8 1.8 4.5 5 3.4c2.2-.8 4.5 0 6 2 1.5-2 3.8-2.8 6-2 3.2 1.1 4.4 4.6 3 7.8-2.5 4.7-10 9.3-10 9.3Z"/>
          </svg>
        </span>
        <span>Wishlist</span>
      </a>

      <a href="{{ routes.account_url }}" class="dalbe-header__action">
        <span class="svg-wrapper" aria-hidden="true">{{ 'icon-account.svg' | inline_asset_content }}</span>
        {% comment %}
          dalbe: hardcoded rather than {{ 'content.account_title' | t }} —
          that key resolves to the theme's built-in English string
          ("Account"), not blank, so | default: 'Contul meu' never actually
          kicks in (default only applies to nil/empty values, not just
          "not the string I wanted").
        {% endcomment %}
        <span>Contul meu</span>
      </a>

      <a href="{{ routes.cart_url }}" class="dalbe-header__action dalbe-header__action--cart">
        <span class="svg-wrapper" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <span>Coș</span>
        {% if cart.item_count > 0 %}
          <span class="dalbe-header__cart-count">{{ cart.item_count }}</span>
        {% else %}
          <span class="dalbe-header__cart-count">0</span>
        {% endif %}
      </a>
    </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .dalbe-header {
    position: relative;
    z-index: 200;
    background: var(--color-background);
    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
  }

  /* dalbe: .dalbe-header__inner is left as a plain .section--full-width
     grid container (no display:flex of its own) — putting the flex row
     styles directly on it, as an earlier version of this did, silently
     overrode the grid, and everything sat flush against the viewport's
     left edge instead. The actual flex row lives one level down, on
     .dalbe-header__row, which is full-width (spans grid-column: 1/-1)
     rather than the standard page-width margin (40px+, responsive) used
     elsewhere on the site — this row wants a smaller, fixed edge padding
     instead, closer to the viewport edge than the rest of the page. */
  .dalbe-header__row {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding-block: var(--padding-md);
    padding-inline: 1.5rem;
  }

  /* dalbe: middle (search + phone) needs to line up with the free-shipping
     message in the category-nav trigger bar below, not sit at the row's
     own visual center — its left edge is the nav's sidebar width (280px)
     plus that section's own page-margin offset (see the --dalbe-left-margin
     formula duplicated in dalbe-category-nav.liquid; duplicated again here
     rather than shared, per that file's established convention, since each
     section resolves the same vw-based formula independently). Anchoring
     via position:absolute (instead of flex auto-margins) decouples this
     from however wide the logo/action-icons happen to be. */
  .dalbe-header__row {
    position: relative;
    --dalbe-header-page-margin-offset: max(
      var(--page-margin),
      calc((100vw - min(calc(var(--page-width) - var(--page-margin) * 2), calc(100vw - var(--page-margin) * 2))) / 2)
    );
    --dalbe-header-left-margin: calc(var(--dalbe-header-page-margin-offset) + 280px);
  }

  .dalbe-header__brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .dalbe-header__middle {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
  }

  @media screen and (min-width: 990px) {
    .dalbe-header__middle {
      position: absolute;
      left: var(--dalbe-header-left-margin);
      top: 50%;
      transform: translateY(-50%);
    }
  }

  .dalbe-header__logo {
    display: flex;
    align-items: center;
  }

  .dalbe-header__logo-image {
    height: 52px;
    width: auto;
    object-fit: contain;
  }

  /* dalbe: when no logo image is uploaded, snippets/image.liquid's
     text_fallback renders shop.name as plain unwrapped text (no element/
     class of its own to target) directly inside .dalbe-header__logo — so
     this styles that case via the link itself. */
  .dalbe-header__logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dalbe-navy);
    text-decoration: none;
  }

  .dalbe-header__search {
    flex: 0 0 auto;
    width: 320px;
    display: flex;
    position: relative;
    /* dalbe: <predictive-search-component> gets a global native rule
       (position:relative; z-index: var(--layer-heightened), i.e. 4) that
       traps our results dropdown's own z-index inside a stacking context
       capped at 4 -- losing to the category-nav trigger bar's z-index:18
       (var(--layer-menu-drawer)) and anything after it, regardless of the
       dropdown's own z-index value. Overriding it here with a more
       specific selector so the whole search component -- dropdown
       included -- sits above the rest of the page. */
    z-index: var(--layer-temporary, 20);
  }

  .dalbe-header__search-input {
    width: 100%;
    min-width: 0;
    padding: 0.625rem 32px 0.625rem var(--padding-lg);
    border: 1px solid var(--color-border);
    border-radius: 4px 0 0 4px;
    font-size: 0.9375rem;
    font-family: inherit;
  }

  /* dalbe: the browser's own native search-clear "X" (rendered inside the
     input via this pseudo-element once text is typed) can visually
     overlap the adjacent navy submit button, especially once the field
     gets narrow on mobile -- we already have our own submit icon, so the
     native one is redundant, not just cramped. */
  .dalbe-header__search-input::-webkit-search-cancel-button {
    display: none;
  }

  .dalbe-header__search-submit {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    background: var(--dalbe-navy);
    border: none;
    border-radius: 0 4px 4px 0;
    color: #ffffff;
    cursor: pointer;
  }

  .dalbe-header__search-submit .svg-wrapper,
  .dalbe-header__search-submit svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .dalbe-header__search-form {
    display: flex;
    flex: 1 1 auto;
    width: 100%;
    position: relative;
  }

  .dalbe-header__search-reset {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    right: 56px;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: none;
    color: var(--color-foreground-secondary, #666666);
    cursor: pointer;
  }

  .dalbe-header__search-reset .svg-wrapper,
  .dalbe-header__search-reset svg {
    width: 16px;
    height: 16px;
  }

  .dalbe-header__search-reset[hidden] {
    display: none;
  }

  /* dalbe: visibility requires BOTH real content inside the results box
     AND focus somewhere in the search widget (input, reset button, or a
     result link/pill -- all descendants of .dalbe-header__search, so
     :focus-within stays true while clicking a result). Content alone
     isn't enough: connectedCallback() in predictive-search.js proactively
     loads a "recently viewed" empty-state into this box on page load
     whenever the visitor has any, so a content-only check would pop the
     dropdown open unprompted. Tying it to :focus-within also means
     clicking anywhere outside the widget closes it, since that's exactly
     when focus leaves the container. */
  .dalbe-header__search-results-wrapper {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 100;
    margin-top: 8px;
    background: var(--color-background, #ffffff);
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .dalbe-header__search:focus-within .dalbe-header__search-results-wrapper:has(.dalbe-header__search-results > *) {
    display: block;
  }

  .dalbe-header__search-results {
    max-height: 70vh;
    overflow-y: auto;
  }

  /* dalbe: branded styling layered on top of the native predictive-search
     markup -- title/pill/no-results are native classes re-skinned in
     place, but the product results themselves render our own
     dalbe-product-card (snippets/dalbe-product-card.liquid, the same
     card used on collection grids and carousels) via
     predictive-search-products-list.liquid, just scaled down to fit the
     dropdown's narrow grid cells. Collections/pages/articles/query pills
     still go through native markup (predictive-search-resource-carousel.liquid),
     so only the product card was worth forking here. */
  .dalbe-header__search-results .predictive-search-results__title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dalbe-red);
  }

  .dalbe-header__search-results .predictive-search-results__wrapper-products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .dalbe-header__search-results .dalbe-product-card {
    padding: 10px;
    border-radius: 10px;
  }

  .dalbe-header__search-results .dalbe-product-card:hover {
    transform: translateY(-2px);
  }

  .dalbe-header__search-results .dalbe-product-card__img-wrap {
    width: calc(100% + 20px);
    margin: -10px -10px 8px;
    padding: 8px;
  }

  .dalbe-header__search-results .dalbe-product-card__name {
    font-size: 0.75rem;
    min-height: 2.3em;
    margin: 0 0 6px;
  }

  .dalbe-header__search-results .dalbe-product-card__price {
    font-size: 0.875rem;
    margin: 0 0 8px;
  }

  .dalbe-header__search-results .dalbe-product-card__badge {
    top: 8px;
    left: 8px;
    font-size: 9px;
    padding: 3px 8px;
  }

  /* dalbe: at this width the pill radius from the full-size button (999px)
     turns into a bulging blob once "Adaugă în coș" wraps to two lines, and
     the icon ends up stranded beside the first line only -- so this
     variant drops the icon and switches to a small fixed radius that
     still reads as a clean rounded button with the text centered across
     both lines. */
  .dalbe-header__search-results .dalbe-product-card .add-to-cart-button {
    border-radius: 10px !important;
    font-size: 0.6875rem !important;
    line-height: 1.25;
    padding: 8px 6px !important;
  }

  .dalbe-header__search-results .dalbe-product-card .add-to-cart-icon {
    display: none;
  }

  .dalbe-header__search-results .predictive-search-results__pill {
    border: 1px solid #e5e7eb;
    border-radius: 999px;
  }

  .dalbe-header__search-results .predictive-search-results__pill:hover {
    border-color: var(--dalbe-navy);
    background: #f4f5fb !important;
  }

  .dalbe-header__search-results .predictive-search-results__no-results {
    color: #6b7280;
    text-align: center;
  }

  .dalbe-header__phone {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    color: var(--dalbe-header-text, #222222);
    text-decoration: none;
    white-space: nowrap;
  }

  .dalbe-header__phone .svg-wrapper {
    width: 28px;
    height: 28px;
  }

  .dalbe-header__phone-text {
    display: flex;
    flex-direction: column;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .dalbe-header__phone-text small {
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-foreground-secondary, #666666);
  }

  .dalbe-header__actions {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--gap-xl);
  }

  .dalbe-header__action {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: var(--dalbe-header-text, #222222);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .dalbe-header__action .svg-wrapper,
  .dalbe-header__action .svg-wrapper svg {
    width: var(--icon-size-md, 24px);
    height: var(--icon-size-md, 24px);
  }

  .dalbe-header__cart-count {
    position: absolute;
    top: -4px;
    right: -10px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--dalbe-navy);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 989px) {
    .dalbe-header__row {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.625rem;
      padding-inline: 1rem;
    }

    .dalbe-header__phone {
      display: none;
    }

    /* dalbe: logo + search + 3 action icons genuinely don't have room to
       coexist on one row at mobile widths -- even after freeing up every
       spare pixel (icon-only actions, no phone), the search input still
       only got ~115px, too narrow to read what you're typing. Standard
       fix: logo and actions share row 1, search bar gets its own full
       -width row 2 below, rather than fighting the other two for scraps
       of a single row's width. */
    .dalbe-header__brand {
      order: 1;
    }

    .dalbe-header__actions {
      order: 2;
      flex: 0 0 auto;
      gap: 0.75rem;
    }

    .dalbe-header__middle {
      order: 3;
      flex: 1 1 100%;
      width: 100%;
      min-width: 0;
    }

    .dalbe-header__search {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
    }

    /* dalbe: three labeled icons (Wishlist/Contul meu/Coș) plus the logo
       and a flexible search bar don't fit one mobile row — the text
       labels were overflowing past the viewport edge. Icon + cart-count
       badge stay, the text labels collapse to icon-only on mobile. */
    .dalbe-header__action > span:not(.svg-wrapper):not(.dalbe-header__cart-count) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "dalbe-header-section",
  "settings": [
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Cauta in catalogul nostru"
    },
    {
      "type": "header",
      "content": "Phone"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Suport Telefonic"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "021.308.57.51"
    }
  ]
}
{% endschema %}
