{%- doc -%}
  Custom on-brand product carousel (medicam3.ro "m3c-" widget), replacing the
  stock Horizon product-list section on the homepage.
{%- enddoc -%}

{% liquid
  assign carousel_collection = section.settings.collection
  assign heading = section.settings.heading
  if heading == blank and carousel_collection != blank
    assign heading = carousel_collection.title
  endif
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and carousel_collection != blank
    assign view_all_url = carousel_collection.url
  endif
%}

{% if carousel_collection == blank or shop.products_count == 0 %}
  {% if request.design_mode %}
    <div class="dalbe-product-carousel dalbe-product-carousel--empty">
      Selectează o colecție cu produse pentru a afișa acest carusel.
    </div>
  {% endif %}
{% else %}
  <div class="dalbe-product-carousel" id="dalbe-carousel-{{ section.id }}">
    <div class="dalbe-product-carousel__header">
      <h2 class="dalbe-product-carousel__title">{{ heading }}</h2>
      {% if view_all_url != blank %}
        <a href="{{ view_all_url }}" class="dalbe-product-carousel__view-all">
          Vezi toate
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="dalbe-product-carousel__wrapper">
      <button type="button" class="dalbe-product-carousel__nav dalbe-product-carousel__nav--prev" data-carousel-prev aria-label="{{ 'actions.previous' | t | default: 'Anterior' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="dalbe-product-carousel__track" data-carousel-track>
        {% for product in carousel_collection.products limit: section.settings.products_to_show %}
          {% liquid
            assign variant = product.selected_or_first_available_variant
            assign on_sale = false
            if variant.compare_at_price > variant.price
              assign on_sale = true
              assign discount_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
            endif
            assign card_image = product.featured_image | default: product.images.first
          %}
          <div class="dalbe-product-carousel__card">
            {% if on_sale %}
              <span class="dalbe-product-carousel__badge">-{{ discount_pct }}%</span>
            {% endif %}
            <a href="{{ product.url }}" class="dalbe-product-carousel__card-link">
              <div class="dalbe-product-carousel__card-img">
                {% if card_image %}
                  <img
                    src="{{ card_image | image_url: width: 300 }}"
                    alt="{{ card_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="150"
                    height="185"
                  >
                {% endif %}
              </div>
              <h3 class="dalbe-product-carousel__card-name">{{ product.title }}</h3>
            </a>
            <div class="dalbe-product-carousel__card-price">
              {% if on_sale %}
                <del aria-hidden="true">{{ variant.compare_at_price | money }}</del>
                <span class="visually-hidden">{{ 'accessibility.was_price' | t | default: 'Prețul inițial a fost:' }} {{ variant.compare_at_price | money }}</span>
                <ins aria-hidden="true">{{ variant.price | money }}</ins>
                <span class="visually-hidden">{{ 'accessibility.now_price' | t | default: 'Prețul curent este:' }} {{ variant.price | money }}</span>
              {% else %}
                {{ variant.price | money }}
              {% endif %}
            </div>
            <div class="dalbe-product-carousel__card-bottom">
              {% liquid
                assign cart_variant = product.selected_or_first_available_variant
                assign needs_variant_choice = false
                if product.has_only_default_variant == false and product.variants.size > 1
                  assign needs_variant_choice = true
                endif
              %}
              {% if needs_variant_choice %}
                <a href="{{ product.url }}" class="add-to-cart-button dalbe-product-carousel__cta">
                  <span class="svg-wrapper add-to-cart-icon">{{ 'icon-add-to-cart.svg' | inline_asset_content }}</span>
                  Alege opțiunile
                </a>
              {% else %}
                <product-form-component
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ product.id }}"
                  on:submit="/handleSubmit"
                  class="dalbe-product-carousel__form"
                >
                  {% assign carousel_form_id = 'CarouselForm-' | append: product.id | append: '-' | append: section.id %}
                  {%- form 'product', product, id: carousel_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ cart_variant.id }}" {% unless cart_variant.available %}disabled{% endunless %}>
                    <input type="hidden" name="quantity" value="1">
                    {% render 'add-to-cart-button',
                      add_to_cart_text: 'Adaugă în coș',
                      class: 'dalbe-product-carousel__cta add-to-cart-button',
                      can_add_to_cart: cart_variant.available,
                      product: product
                    %}
                  {%- endform -%}
                </product-form-component>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <button type="button" class="dalbe-product-carousel__nav dalbe-product-carousel__nav--next" data-carousel-next aria-label="{{ 'actions.next' | t | default: 'Următor' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('dalbe-carousel-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('[data-carousel-track]');
      if (!track) return;

      function updateNav() {
        var prev = root.querySelector('[data-carousel-prev]');
        var next = root.querySelector('[data-carousel-next]');
        if (!prev || !next) return;
        var max = track.scrollWidth - track.clientWidth - 2;
        prev.style.opacity = track.scrollLeft <= 0 ? '0' : '1';
        prev.style.pointerEvents = track.scrollLeft <= 0 ? 'none' : 'auto';
        next.style.opacity = track.scrollLeft >= max ? '0' : '1';
        next.style.pointerEvents = track.scrollLeft >= max ? 'none' : 'auto';
      }

      root.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-carousel-prev], [data-carousel-next]');
        if (!trigger) return;
        event.preventDefault();
        var direction = trigger.hasAttribute('data-carousel-prev') ? -1 : 1;
        var card = track.querySelector('.dalbe-product-carousel__card');
        var cardWidth = card ? card.getBoundingClientRect().width + 20 : 300;
        var amount = direction * cardWidth * 2;
        if (track.scrollBy) {
          track.scrollBy({ left: amount, behavior: 'smooth' });
        } else {
          track.scrollLeft += amount;
        }
      });

      track.addEventListener('scroll', updateNav, { passive: true });
      window.addEventListener('resize', updateNav);
      updateNav();
    })();
  </script>
{% endif %}

{% stylesheet %}
  .dalbe-product-carousel {
    max-width: 1200px;
    margin: 40px auto 50px;
    padding: 0 20px;
  }

  .dalbe-product-carousel--empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--color-foreground, #666);
    border: 1px dashed #ccc;
    border-radius: 12px;
  }

  .dalbe-product-carousel__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-block-end: 20px;
    margin-block-end: 20px;
    border-block-end: 1px solid #e5e5e5;
  }

  .dalbe-product-carousel__title {
    position: relative;
    font-size: 26px;
    font-weight: 800;
    color: var(--dalbe-navy);
    margin: 0 0 12px;
    padding-block-end: 12px;
    background: none !important;
  }

  .dalbe-product-carousel__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 48px;
    height: 3px;
    background: var(--dalbe-red);
  }

  .dalbe-product-carousel__header {
    align-items: flex-start !important;
  }

  .dalbe-product-carousel__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--dalbe-navy) !important;
    text-decoration: none !important;
    white-space: nowrap;
    border: 1px solid var(--dalbe-navy) !important;
    background: none !important;
    padding: 10px 20px !important;
    border-radius: 999px !important;
  }

  .dalbe-product-carousel__view-all:hover {
    background: var(--dalbe-navy) !important;
    color: #fff !important;
  }

  .dalbe-product-carousel__wrapper {
    position: relative;
  }

  .dalbe-product-carousel__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .dalbe-product-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .dalbe-product-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(calc(-50% - 17px));
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--dalbe-navy);
    color: #fff;
    border: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px 0 rgba(0, 0, 0, 0.08);
    cursor: pointer;
    z-index: 3;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .dalbe-product-carousel__nav:hover {
    background: var(--dalbe-red);
  }

  .dalbe-product-carousel__nav--prev {
    left: -17px;
  }

  .dalbe-product-carousel__nav--next {
    right: -17px;
  }

  .dalbe-product-carousel__card {
    position: relative;
    flex: 0 0 auto;
    width: 210px;
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid #eef0f5;
    border-radius: 12px;
    padding: 15px 12px 12px;
    display: flex;
    flex-direction: column;
  }

  .dalbe-product-carousel__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--dalbe-red);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .dalbe-product-carousel__card-link {
    text-decoration: none;
    display: block;
  }

  .dalbe-product-carousel__card-img {
    width: 100%;
    height: 210px;
    margin: 0 auto;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dalbe-product-carousel__card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dalbe-product-carousel__card-name {
    font-size: 13px;
    font-weight: 600;
    color: #2d3748;
    line-height: 18.2px;
    min-height: 36px;
    margin: 8px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dalbe-product-carousel__card-price {
    color: var(--dalbe-navy);
    font-size: 18px;
    font-weight: 800;
    margin: 8px 0;
  }

  .dalbe-product-carousel__card-price del {
    color: #9aa1b3;
    font-size: 13px;
    font-weight: 500;
    text-decoration: line-through;
    margin-inline-end: 4px;
    display: inline-block;
  }

  .dalbe-product-carousel__card-price ins {
    color: var(--dalbe-red);
    text-decoration: none;
  }

  .dalbe-product-carousel__card-bottom {
    margin-top: auto;
  }

  .dalbe-product-carousel__card-bottom .quick-add,
  .dalbe-product-carousel__card-bottom quick-add-component,
  .dalbe-product-carousel__card-bottom product-form-component {
    display: block;
    width: 100%;
  }

  .dalbe-product-carousel__card-bottom .add-to-cart-button {
    width: 100%;
    background: var(--dalbe-red) !important;
    color: #fff !important;
    border-radius: 8px !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    padding: 8px 10px !important;
    border: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .dalbe-product-carousel__card-bottom .add-to-cart-icon svg {
    width: 14px;
    height: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Carusel produse (custom)",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colecție"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu (implicit: numele colecției)"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link \"Vezi toate\" (implicit: pagina colecției)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produse afișate",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Carusel produse (custom)"
    }
  ]
}
{% endschema %}
