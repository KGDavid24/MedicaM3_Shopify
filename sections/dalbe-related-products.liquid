{%- doc -%}
  Generic "related products" grid — a handful of hand-picked products shown
  at the end of a page or article (e.g. a blog post that references specific
  products by name), matching the WooCommerce product-grid widget the real
  medicam3.ro site embeds at the end of some articles. Each block references
  one real product directly, so image/title/price stay live.
{%- enddoc -%}

{% if section.blocks.size > 0 %}
  <div class="dalbe-related-products">
    {% if section.settings.heading != blank %}
      <h2 class="dalbe-related-products__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="dalbe-related-products__grid">
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          if product == blank
            continue
          endif
          assign variant = product.selected_or_first_available_variant
          assign on_sale = false
          if variant.compare_at_price > variant.price
            assign on_sale = true
          endif
        %}
        <a href="{{ product.url }}" class="dalbe-related-products__card" {{ block.shopify_attributes }}>
          {% if product.featured_image %}
            <div class="dalbe-related-products__img-wrap">
              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'dalbe-related-products__img' }}
            </div>
          {% endif %}
          <h3 class="dalbe-related-products__name">{{ product.title }}</h3>
          <div class="dalbe-related-products__price">
            {% if on_sale %}
              <del>{{ variant.compare_at_price | money }}</del>
              <ins>{{ variant.price | money }}</ins>
            {% else %}
              {{ variant.price | money }}
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .dalbe-related-products {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
  }

  .dalbe-related-products__heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--dalbe-navy);
    margin: 0 0 20px;
  }

  .dalbe-related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .dalbe-related-products__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .dalbe-related-products__card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #eef0f5;
    border-radius: 12px;
    padding: 16px;
    text-decoration: none;
    transition: box-shadow 0.2s ease;
  }

  .dalbe-related-products__card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .dalbe-related-products__img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-block-end: 12px;
  }

  .dalbe-related-products__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dalbe-related-products__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #2d3748;
    line-height: 1.35;
    margin: 0 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dalbe-related-products__price {
    margin-top: auto;
    font-size: 1rem;
    font-weight: 800;
    color: var(--dalbe-navy);
  }

  .dalbe-related-products__price del {
    color: #9aa1b3;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: line-through;
    margin-inline-end: 4px;
  }

  .dalbe-related-products__price ins {
    color: var(--dalbe-red);
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produse recomandate",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Produse recomandate"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Produs",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produse recomandate",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}
