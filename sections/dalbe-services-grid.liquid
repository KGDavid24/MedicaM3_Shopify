{%- style -%}
  .custom-services-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #ffffff;
    font-family: inherit;
  }
  
  .custom-services-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .custom-services-header {
    text-align: center;
    margin-bottom: 48px;
  }
  
  .custom-services-header h2 {
    color: #12154c; /* Matches the dark blue in the image */
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 12px;
  }
  
  .custom-services-header p {
    color: #4a4a4a;
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.5;
  }
  
  .custom-services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  
  @media (min-width: 768px) {
    .custom-services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .custom-service-card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  
  .custom-service-card:hover {
    transform: translateY(-5px);
  }
  
  .custom-service-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }
  
  .custom-service-content {
    background-color: #12154c;
    color: #ffffff;
    padding: 32px 24px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .custom-service-content h3 {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  
  .custom-service-content p {
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.5;
    color: #f1f1f1;
  }
  
  /* Fallback for empty image placeholder */
  .placeholder-svg {
    background-color: #f4f4f4;
    width: 100%;
    height: 280px;
  }
{%- endstyle -%}

<div class="custom-services-{{ section.id }}">
  <div class="custom-services-container">
    <div class="custom-services-header">
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="custom-services-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="custom-service-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: class: 'custom-service-image', loading: 'lazy' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg custom-service-image' }}
          {%- endif -%}
          
          <div class="custom-service-content">
            <h3>{{ block.settings.title }} &rarr;</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Services Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Cu ce te putem ajuta?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Alege soluția potrivită pentru tine și descoperă echipamentele și consumabilele de care ai nevoie."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Service Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Add a short description about this service or category."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Services Grid",
      "blocks": [
        { "type": "service" },
        { "type": "service" },
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}