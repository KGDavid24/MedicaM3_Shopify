{%- doc -%}
  A numbered "how we help" process list. One component, two display modes
  set via display_mode: `compact` (icon + title + one-line teaser, a row of
  tiles) and `detailed` (numbered badge + title + full body + CTA, a
  stacked list). Instantiated twice on the Clinica la cheie page, matching
  the source site's own compact-overview-then-detailed-list structure —
  the same block/section code renders both, not two forked
  implementations; only the block content differs between the two
  instances.
{%- enddoc -%}

<div class="dalbe-process-steps dalbe-process-steps--{{ section.settings.display_mode }} section section--page-width">
  {% if section.settings.heading != blank %}
    <h2 class="dalbe-process-steps__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <ol class="dalbe-process-steps__list list-unstyled">
    {% content_for 'blocks' %}
  </ol>
</div>

{% stylesheet %}
  .dalbe-process-steps {
    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
    padding-block: var(--padding-xl);
  }

  .dalbe-process-steps__heading {
    text-align: center;
    margin: 0 0 var(--margin-xl);
  }

  .dalbe-process-steps__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Compact: row of icon tiles */
  .dalbe-process-steps--compact .dalbe-process-steps__list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gap-lg);
  }

  .dalbe-process-steps--compact .dalbe-process-steps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--gap-xs);
  }

  .dalbe-process-steps__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dalbe-process-steps__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dalbe-process-steps--compact .dalbe-process-steps__title {
    font-size: 1rem;
    margin: 0;
  }

  .dalbe-process-steps__teaser {
    margin: 0;
    color: var(--color-foreground-secondary, #666666);
    font-size: 0.875rem;
  }

  @media screen and (max-width: 989px) {
    .dalbe-process-steps--compact .dalbe-process-steps__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Detailed: stacked numbered list */
  .dalbe-process-steps--detailed .dalbe-process-steps__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
    max-width: 48rem;
    margin-inline: auto;
  }

  .dalbe-process-steps--detailed .dalbe-process-steps__item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--gap-lg);
  }

  .dalbe-process-steps__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--dalbe-navy);
    color: #ffffff;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .dalbe-process-steps--detailed .dalbe-process-steps__title {
    margin: 0 0 var(--margin-2xs);
  }

  .dalbe-process-steps__body {
    color: var(--dalbe-text, #222222);
  }

  .dalbe-process-steps__body p {
    margin: 0 0 var(--margin-sm);
  }

  .dalbe-process-steps__cta {
    display: inline-block;
    margin-block-start: var(--margin-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Process steps",
  "tag": "div",
  "class": "dalbe-process-steps-section",
  "blocks": [
    {
      "type": "dalbe-process-step"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        {
          "value": "compact",
          "label": "Compact (icon tiles)"
        },
        {
          "value": "detailed",
          "label": "Detailed (numbered list)"
        }
      ],
      "default": "compact"
    }
  ],
  "presets": [
    {
      "name": "Process steps"
    }
  ]
}
{% endschema %}
